<Window x:Class="WpfTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfTool"
        mc:Ignorable="d"
        Title="P4 Annotate" Height="450" Width="800">
    <Grid>
        <Menu>
            <MenuItem Header="File">
                <MenuItem Name="UiOpen" Header="Open..." Click="UiOpen_Click"></MenuItem>
                <MenuItem Name="UiGetInfo" Header="Get Info" Click="UiGetInfo_Click"></MenuItem>
                <Separator></Separator>
                <MenuItem Name="UiExit" Header="Exit" Click="UiExit_Click"></MenuItem>
            </MenuItem>
        </Menu>
        <TextBox x:Name="UiOutput" Margin="20" MinHeight="350" MinWidth="700" VerticalAlignment="Center" HorizontalAlignment="Center" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Auto"></TextBox>
    </Grid>
</Window>
