<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="WpfTool.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
    </startup>
    <userSettings>
        <WpfTool.Properties.Settings>
            <setting name="EditorPath" serializeAs="String">
                <value>%SystemRoot%\System32\notepad.exe</value>
            </setting>
            <setting name="P4Path" serializeAs="String">
                <value>C:\Program Files\Perforce\P4.exe</value>
            </setting>
        </WpfTool.Properties.Settings>
    </userSettings>
</configuration>
