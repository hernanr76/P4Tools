<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="uri:settings" CurrentProfile="(Default)">
  <Profiles>
    <Profile Name="(Default)" />
  </Profiles>
  <Settings>
    <Setting Name="EditorPath" Type="System.String" Scope="User">
      <Value Profile="(Default)">%SystemRoot%\System32\notepad.exe</Value>
    </Setting>
    <Setting Name="P4Path" Type="System.String" Scope="User">
      <Value Profile="(Default)">C:\Program Files\Perforce\P4.exe</Value>
    </Setting>
  </Settings>
</SettingsFile>
